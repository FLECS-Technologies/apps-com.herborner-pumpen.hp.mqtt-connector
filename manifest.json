{
    "$schema": "https://raw.githubusercontent.com/FLECS-Technologies/app-sdk/3.0.0/manifest.schema.json",
    "_schemaVersion": "3.0.0",
    "app": "com.herborner-pumpen.hp.mqtt-connector",
    "version": "##VERSION##",
    "revision": "0",
    "image": "flecs.azurecr.io/com.herborner-pumpen.hp.mqtt-connector",
    "multiInstance": false,
    "editors": [{  "name": "MQTT Connector WebUI",  "port": 9330,  "supportsReverseProxy": true}],
    "ports":[
        "1883:1883",
        "8883:8883"
    ],
    "env":[
        "LOGLEVEL=notice",
        "FLECS_API_ADDRESS=172.21.0.1:8081"
    ],
    "volumes":[
        "data:/app/data"
    ]
}
